{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "boat-configurator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "tools/boat-configurator",
        "run",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "site-win",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "boat-built",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8093"
      ],
      "port": 8093,
      "autoPort": false
    },
    {
      "name": "boat-uw",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8094",
        "--directory",
        "D:/bw/uw"
      ],
      "port": 8094
    }
  ]
}
